{
  "name": "bhandsmusic",
  "productName": "BhandsMusic",
  "version": "2.2.7",
  "description": "沉浸式音乐播放器，融合天气电台、歌词舞台、粒子视觉和 3D 歌单架。",
  "author": "BhandsMusic",
  "main": "desktop/main.js",
  "private": true,
  "config": {
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "scripts": {
    "start": "electron .",
    "start:win": "chcp 65001 >nul && electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "check:hoisting": "node scripts/check-app-hoisting.js",
    "check:reorg": "node scripts/check-app-reorg.js",
    "probe:ui": "node scripts/probe-ui-all.js",
    "probe:static": "node scripts/probe-static-exposure.js",
    "probe:nsis": "node scripts/probe-nsis-syntax.js",
    "probe:cuefield-api": "node scripts/probe-cuefield-api.js",
    "probe:cuefield-e2e": "node scripts/probe-cuefield-transition-e2e.js",
    "probe:parse": "node scripts/e2e-parse-level.js",
    "prebuild:win": "node build/fetch-go-music-api.js && node build/fetch-kugou-api.js && node build/fetch-splash-video.js",
    "build:win": "electron-builder --win nsis",
    "prebuild:win:dir": "node build/fetch-go-music-api.js && node build/fetch-kugou-api.js && node build/fetch-splash-video.js",
    "build:win:dir": "electron-builder --win dir",
    "prebuild:mac": "node build/fetch-go-music-api.js --platform darwin --arch arm64 --force && node build/fetch-kugou-api.js && node build/fetch-splash-video.js",
    "build:mac": "electron-builder --mac dmg",
    "prebuild:mac:x64": "node build/fetch-go-music-api.js --platform darwin --arch x64 --force && node build/fetch-kugou-api.js && node build/fetch-splash-video.js",
    "build:mac:x64": "electron-builder --mac dmg --x64",
    "build:mac:all": "npm run build:mac && npm run build:mac:x64 && node scripts/merge-latest-mac-yml.js",
    "prebuild:mac:dir": "node build/fetch-go-music-api.js --platform darwin --arch arm64 --force && node build/fetch-kugou-api.js && node build/fetch-splash-video.js",
    "build:mac:dir": "electron-builder --mac dir"
  },
  "build": {
    "appId": "com.bhandsmusic.desktop",
    "productName": "BhandsMusic",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "build/**/*",
      "server/**/*",
      "cuefield/**/*",
      "vendor/go-music-api/**/*",
      "package.json",
      "!public/index.*.html",
      "public/index.html",
      "vendor/kugou-api/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "server/server.js",
      "server/dj-analyzer.js",
      "cuefield/**/*",
      "vendor/go-music-api/**/*",
      "vendor/kugou-api/**/*"
    ],
    "win": {
      "executableName": "BhandsMusic",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BhandsMusic",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "artifactName": "BhandsMusic-${version}-Setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "BhandsMusic-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSHumanReadableCopyright": "BhandsMusic",
        "NSMicrophoneUsageDescription": "用于音频可视化与 DJ 分析功能采集音频输入。"
      }
    },
    "dmg": {
      "title": "BhandsMusic ${version}",
      "artifactName": "BhandsMusic-${version}-mac-${arch}.${ext}",
      "contents": [
        {
          "x": 140,
          "y": 210
        },
        {
          "x": 400,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bhands6",
        "repo": "BhandsMusicChange"
      }
    ]
  },
  "bhandsmusic": {
    "update": {
      "provider": "github",
      "owner": "Bhands6",
      "repo": "BhandsMusicChange",
      "preview": true,
      "preferMirrors": true,
      "mirrors": [
        "https://gh.llkk.cc/",
        "https://ghfast.top/",
        "https://gh-proxy.com/"
      ]
    }
  },
  "dependencies": {
    "@unblockneteasemusic/server": "^0.28.0",
    "axios": "^1.18.1",
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "music-metadata": "^11.14.0",
    "NeteaseCloudMusicApi": "^4.32.0",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "esprima": "^4.0.1",
    "rcedit": "^5.0.2"
  }
}
